# Copy to .env.local and fill in. Every variable is optional for local testing:
# without them the chat still works (rule-based replies, all slots shown as free, emails logged).

# --- Google Calendar (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=bosetti-booking@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key, keeping the \n sequences, inside double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The calendar the surveys go into (Settings → Integrate calendar → Calendar ID)
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# --- Email (Nodemailer). Gmail by default: use an App Password, not the account password. ---
EMAIL_USER=
EMAIL_PASS=
# Optional custom SMTP instead of Gmail
EMAIL_HOST=
EMAIL_PORT=465
# Where new bookings and changes are sent
ADMIN_NOTIFICATION_EMAIL=

# --- LLM for free-text questions: Gemini first, then Anthropic, then OpenAI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Meta Conversions API (server-side Lead, deduplicated with the browser pixel) ---
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Higgsfield (image generation script only, not used by the site) ---
HF_CREDENTIALS=
